# Passcode for the phone app (owner login)
ACCESS_CODE=
# Signs session cookies
SESSION_SECRET=
# Encrypts the API keys stored from Settings
SETTINGS_KEY=
# Shared with the Mexty backend (same value as its RIDE_STUDIO_SECRET): verifies change-event webhooks and mints the preview session
RIDE_STUDIO_SECRET=
# Where settings, device pairings and bake-off audio live (mount a volume here)
DATA_DIR=/data
# Optional: keys can also be set from Settings instead
# ANTHROPIC_API_KEY= ELEVENLABS_API_KEY= DEEPGRAM_API_KEY= OPENAI_API_KEY=
